{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adalaj-ops-erp",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adalaj-erp-db",
      "database_id": "6b9e1a3a-2024-4d3d-9a2d-39ba91a9aaa1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "c152967af3f94a80949fac6b147eb787"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS_BUCKET",
      "bucket_name": "adalaj-erp-receipts"
    }
  ]
}
